---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import PorQueExiste from '../components/sections/PorQueExiste.astro';
import Temporada from '../components/sections/Temporada.astro';
import ComoParticipar from '../components/sections/ComoParticipar.astro';
import ComoE from '../components/sections/ComoE.astro';
import Lugar from '../components/sections/Lugar.astro';
import QuemConduz from '../components/sections/QuemConduz.astro';
import Turma from '../components/sections/Turma.astro';
import Inscricao from '../components/sections/Inscricao.astro';
import Rodape from '../components/sections/Rodape.astro';
import StickyCta from '../components/sections/StickyCta.astro';
---
<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <PorQueExiste />
    <Temporada />
    <ComoParticipar />
    <ComoE />
    <Lugar />
    <QuemConduz />
    <Turma />
    <Inscricao />
  </main>
  <Rodape />
  <StickyCta />
</Base>
