---
import { Image } from 'astro:assets';
import onCor from '../../assets/logos/on-educacao.png';
import onBranco from '../../assets/logos/on-educacao-branco.png';
import immCor from '../../assets/logos/immunogenic.png';
import immBranco from '../../assets/logos/immunogenic-branco.png';
import cliCor from '../../assets/logos/clinica-alergologica.png';
import cliBranco from '../../assets/logos/clinica-alergologica-branco.png';

interface Props {
  logo: 'on' | 'immunogenic' | 'alergologica';
  nome: string;
  variant?: 'light' | 'dark';
  class?: string;
}
const { logo, nome, variant = 'dark', class: klass = '' } = Astro.props;

/**
 * As três marcas têm proporções diferentes: a ON é uma palavra com assinatura,
 * a Immunogenic tem o símbolo mais alto que o texto e a Clínica Alergológica é
 * uma marca de duas linhas. O fator `otico` iguala a altura VISUAL, não a caixa.
 *
 * A altura final sai de --logo-h, definida por quem usa o componente, o que
 * permite variá-la por breakpoint sem gerar outro arquivo. `renderH` é o limite
 * físico de cada original — nenhum deles é ampliado.
 */
const marcas = {
  on: { cor: onCor, branco: onBranco, otico: 0.95, renderH: 72 },
  immunogenic: { cor: immCor, branco: immBranco, otico: 1, renderH: 73 },
  alergologica: { cor: cliCor, branco: cliBranco, otico: 1.26, renderH: 48 },
};

const m = marcas[logo];
const src = variant === 'light' ? m.branco : m.cor;
---
<Image
  src={src}
  alt={nome}
  height={m.renderH}
  loading="lazy"
  class={`w-auto max-w-none ${klass}`}
  style={`height: calc(var(--logo-h, 1.75rem) * ${m.otico})`}
/>
