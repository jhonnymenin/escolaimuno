---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Proporção da moldura, ex.: "4/5". Sem ela, a imagem preenche o elemento pai. */
  ratio?: string;
  sizes: string;
  widths: number[];
  position?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const {
  src,
  alt,
  ratio,
  sizes,
  widths,
  position = 'center',
  loading = 'lazy',
  class: klass = '',
} = Astro.props;
---
<div
  class={`relative overflow-hidden bg-navy ${ratio ? '' : 'h-full w-full'} ${klass}`}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    class="h-full w-full object-cover"
    style={`object-position:${position}`}
  />
  <slot />
</div>
