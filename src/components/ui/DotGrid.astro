---
/**
 * Grid de 100 pontos — uma vaga por ponto.
 * Distribuição fixa (seed determinístico) e cascata diagonal de ~1,2s ao entrar na tela.
 * É o único momento animado da página.
 */
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;

const cores = ['#032766', '#0375C0', '#03A7BE', '#2FA8EE', '#5CCFC9'];

// LCG determinístico: mesma distribuição em todo build.
let seed = 20270318;
const rand = () => {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed / 2147483648;
};

const pontos = Array.from({ length: 100 }, (_, i) => {
  const linha = Math.floor(i / 10);
  const coluna = i % 10;
  return {
    cor: cores[Math.floor(rand() * cores.length)],
    // cascata diagonal: 1,2s do primeiro ao último ponto
    delay: `${(((linha + coluna) / 18) * 1.05).toFixed(3)}s`,
  };
});
---
<ul class={`dot-grid grid w-full max-w-[26rem] grid-cols-10 gap-2 sm:gap-2.5 ${klass}`} aria-hidden="true">
  {
    pontos.map((p) => (
      <li class="dot aspect-square rounded-full" style={`background:${p.cor};animation-delay:${p.delay}`} />
    ))
  }
</ul>

<style>
  .dot {
    opacity: 0;
  }

  .dot-grid.is-visible .dot {
    animation: dot-in 0.42s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }

  @keyframes dot-in {
    from {
      opacity: 0;
      transform: scale(0.35);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      opacity: 1;
    }
    .dot-grid.is-visible .dot {
      animation: none;
    }
  }
</style>

<script>
  const grids = document.querySelectorAll<HTMLElement>('.dot-grid');
  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduzido || !('IntersectionObserver' in window)) {
    grids.forEach((g) => g.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    grids.forEach((g) => observer.observe(g));
  }
</script>
