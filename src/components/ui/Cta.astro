---
import { escola } from '../../content/escola';
import { ctaHref, whatsappHref, site } from '../../config/site';

interface Props {
  /** Posição, enviada no evento cta_click. */
  position: string;
  label: string;
  variant?: 'agua' | 'navy' | 'branco' | 'contorno' | 'texto';
  /**
   * Link de checkout específico deste botão, vindo de `config/checkout.ts`.
   * Quando está vazio, o CTA cai para o WhatsApp com a mensagem de `whatsapp`.
   */
  checkout?: string;
  /**
   * Mensagem do WhatsApp usada enquanto não houver checkout para este botão.
   */
  whatsapp?: string;
  /** Destino alternativo, como uma âncora para outra seção. */
  href?: string;
  class?: string;
}
const {
  position,
  label,
  variant = 'agua',
  checkout,
  whatsapp,
  href: hrefProp,
  class: klass = '',
} = Astro.props;

// Prioridade: âncora > checkout deste botão > WhatsApp com a mensagem dada >
// CTA global (PUBLIC_CTA_URL ou, sem ela, WhatsApp com a mensagem padrão).
const destinoCheckout = checkout?.trim() ?? '';
const ehAncora = Boolean(hrefProp);
const ehWhatsapp = !ehAncora && !destinoCheckout && (Boolean(whatsapp) || !site.ctaUrl);

const href =
  hrefProp ||
  destinoCheckout ||
  (whatsapp ? whatsappHref(whatsapp) : ctaHref(escola.whatsappMensagem));

const base =
  'inline-flex items-center justify-center rounded-[4px] font-semibold transition-colors duration-150';
const estilos = {
  agua: 'bg-agua text-navy px-7 py-4 text-base hover:bg-white',
  navy: 'bg-navy text-white px-7 py-4 text-base hover:bg-azul',
  branco: 'bg-white text-navy px-7 py-4 text-base hover:bg-agua',
  contorno: 'border border-navy text-navy px-7 py-4 text-base hover:bg-navy hover:text-white',
  texto:
    'text-sm font-semibold underline underline-offset-[6px] decoration-1 decoration-agua hover:decoration-2 px-0 py-1',
};
---
<a
  href={href}
  data-cta
  data-cta-position={position}
  data-cta-whatsapp={ehWhatsapp ? 'true' : 'false'}
  class={`${base} ${estilos[variant]} ${klass}`}
>
  {label}
</a>
