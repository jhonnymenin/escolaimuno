---
import { Image } from 'astro:assets';
import cor from '../../assets/logos/escola.png';
import branco from '../../assets/logos/escola-branco.png';
import { escola } from '../../content/escola';

interface Props {
  variant?: 'light' | 'dark';
  class?: string;
  /** Decorativa quando já existe texto equivalente ao lado. */
  decorativa?: boolean;
  eager?: boolean;
}
const { variant = 'dark', class: klass = '', decorativa = false, eager = false } = Astro.props;
const src = variant === 'light' ? branco : cor;
---
<Image
  src={src}
  alt={decorativa ? '' : escola.nome}
  height={88}
  loading={eager ? 'eager' : 'lazy'}
  class={`w-auto max-w-none ${klass}`}
/>
