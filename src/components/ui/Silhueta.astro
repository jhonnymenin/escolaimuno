---
/** Silhueta humana em traço fino, com pontos nos órgãos-alvo. */
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;

const alvos = [
  { cx: 100, cy: 36, r: 7, cor: '#032766' },   // sistema nervoso
  { cx: 100, cy: 96, r: 6.5, cor: '#03A7BE' }, // vias aéreas
  { cx: 146, cy: 122, r: 5.5, cor: '#2FA8EE' },// articulações
  { cx: 100, cy: 158, r: 6.5, cor: '#0375C0' },// trato gastrointestinal
  { cx: 54, cy: 186, r: 5.5, cor: '#5CCFC9' }, // pele
];
---
<svg class={klass} viewBox="0 0 200 300" fill="none" aria-hidden="true" focusable="false">
  <g stroke="#C6D3E4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="100" cy="36" r="18" />
    <path d="M100 54v104" />
    <path d="M100 96 54 122" />
    <path d="M100 96l46 26" />
    <path d="M54 122v64" />
    <path d="M146 122v64" />
    <path d="M100 158 74 196l-8 82" />
    <path d="M100 158l26 38 8 82" />
  </g>
  {
    alvos.map((a) => (
      <>
        <circle cx={a.cx} cy={a.cy} r={a.r * 2.5} fill={a.cor} opacity="0.1" />
        <circle cx={a.cx} cy={a.cy} r={a.r} fill={a.cor} />
      </>
    ))
  }
</svg>
