---
import Foto from '../ui/Foto.astro';
import { escola } from '../../content/escola';
import foto from '../../assets/fotos/seringa-frasco-duotone-claro.jpg';
const s = escola.porQueExiste;
---
<section id="por-que" class="bg-white py-16 sm:py-24 lg:py-32">
  <div class="shell">
    <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-10 lg:gap-x-16">
      <div class="md:col-span-7">
        <h2 class="h2-fluid max-w-[18ch]">{s.titulo}</h2>
        <div class="measure mt-7 space-y-5 text-ink2 sm:mt-8">
          {s.paragrafos.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="md:col-span-5">
        <Foto
          src={foto}
          alt="Profissional de saúde aspirando medicamento de um frasco-ampola"
          ratio="3/4"
          position="center 45%"
          sizes="(min-width: 1024px) 34vw, (min-width: 768px) 40vw, 100vw"
          widths={[400, 560, 760, 960]}
        />
      </div>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-x-10 gap-y-8 border-t border-line pt-10 sm:grid-cols-3 sm:gap-x-12 lg:mt-20 lg:pt-12"
    >
      {
        s.principios.map((p) => (
          <div>
            <h3 class="h3-fluid">{p.titulo}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink2">{p.descricao}</p>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 grid grid-cols-1 gap-x-10 gap-y-4 border-t border-line pt-10 lg:mt-16 lg:grid-cols-12 lg:gap-x-16"
    >
      <h3 class="h3-fluid lg:col-span-4">{s.publicoTitulo}</h3>
      <p class="measure-wide text-ink2 lg:col-span-8">{s.publico}</p>
    </div>
  </div>
</section>
