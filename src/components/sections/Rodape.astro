---
import LogosRealizadores from '../ui/LogosRealizadores.astro';
import LogoEscola from '../ui/LogoEscola.astro';
import { escola } from '../../content/escola';
import { site, sponsorHref } from '../../config/site';
const s = escola.rodape;
const href = sponsorHref();
---
<footer class="bg-white py-14 sm:py-16">
  <div class="shell">
    <div class="grid grid-cols-1 gap-x-16 gap-y-10 border-t border-line pt-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <LogosRealizadores label={s.realizacao} />
      </div>

      {
        site.sponsorContact && (
          <div class="lg:col-span-5">
            <h2 class="font-display text-base font-bold tracking-[-0.01em]">{s.patrocinioTitulo}</h2>
            <p class="mt-2 text-[0.95rem] text-ink2">
              <a
                href={href}
                class="font-semibold text-azul-texto underline underline-offset-[5px] decoration-1 hover:decoration-2"
              >
                {s.patrocinioTexto}
              </a>
            </p>
          </div>
        )
      }
    </div>

    <div class="mt-12 flex flex-col gap-5 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between">
      <LogoEscola />
      <p class="text-sm text-ink2">{s.local}</p>
    </div>
  </div>
</footer>
