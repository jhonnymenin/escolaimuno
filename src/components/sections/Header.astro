---
import LogoEscola from '../ui/LogoEscola.astro';
import Cta from '../ui/Cta.astro';
import { escola } from '../../content/escola';
---
<header
  id="topo"
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-200"
>
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="#topo" class="flex items-center" aria-label={escola.nome}>
      <span class="logo-hero"><LogoEscola variant="light" /></span>
      <span class="logo-scrolled" style="display:none"><LogoEscola variant="dark" /></span>
    </a>
    <Cta position="header" label={escola.header.cta} variant="texto" class="text-white" />
  </div>
</header>

<style>
  [data-header].is-scrolled {
    background: #ffffff;
    border-bottom-color: var(--color-line);
  }
  [data-header].is-scrolled .logo-hero {
    display: none;
  }
  [data-header].is-scrolled .logo-scrolled {
    display: inline-flex !important;
  }
  [data-header].is-scrolled :global(a[data-cta]) {
    color: var(--color-navy);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const atualizar = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 80);
    };
    atualizar();
    window.addEventListener('scroll', atualizar, { passive: true });
  }
</script>
