---
import DotGrid from '../ui/DotGrid.astro';
import { escola } from '../../content/escola';
import { site } from '../../config/site';
const s = escola.turma;
const leva = s.leva.filter((i) => !('flag' in i) || site.flags[i.flag as keyof typeof site.flags]);
---
<section id="turma" class="bg-white pb-16 sm:pb-24 lg:pb-32">
  <div class="shell">
    <div class="pt-14 sm:pt-20 lg:pt-28">
      <p class="eyebrow text-ciano-texto">{s.rotulo}</p>
      <div class="mt-5 grid grid-cols-1 gap-x-10 gap-y-5 lg:grid-cols-12 lg:gap-x-16">
        <h2 class="h2-fluid max-w-[14ch] lg:col-span-6">{s.titulo}</h2>
        <p class="measure text-ink2 lg:col-span-6 lg:self-end">{s.apoio}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 items-center gap-x-12 gap-y-12 md:grid-cols-12 lg:mt-20 lg:gap-x-20">
        <div class="md:col-span-7 lg:col-span-6">
          <DotGrid />
          <ul class="mt-5 flex max-w-[26rem] flex-wrap gap-x-7 gap-y-2">
            {
              s.legenda.map((l) => (
                <li class="flex items-center gap-2.5 text-[0.85rem] text-ink2">
                  <span
                    class:list={[
                      'h-2.5 w-2.5 flex-none rounded-full',
                      l.tipo === 'temporada' ? 'bg-azul' : 'bg-avulso',
                    ]}
                    aria-hidden="true"
                  />
                  {l.texto}
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="space-y-7 md:col-span-5 sm:space-y-9 lg:col-span-6">
          {
            s.numeros.map((n) => (
              <div class="flex items-baseline gap-6">
                <dd class="font-display w-[3ch] shrink-0 text-right text-5xl font-bold tabular-nums tracking-[-0.04em] text-navy sm:text-6xl">
                  {n.valor}
                </dd>
                <dt class="max-w-[14rem] text-[0.95rem] leading-snug text-ink2">{n.rotulo}</dt>
              </div>
            ))
          }
        </dl>
      </div>

      <p class="measure-wide mt-12 border-l-2 border-ciano pl-5 text-ink2 sm:pl-6 lg:mt-16">{s.nota}</p>

      <div class="mt-14 border-t border-line pt-10 lg:mt-20 lg:pt-12">
        <p class="eyebrow text-ink2">{s.levaTitulo}</p>
        <div class="mt-8 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-3 sm:gap-x-12">
          {
            leva.map((i) => (
              <div>
                <h3 class="h3-fluid">{i.titulo}</h3>
                <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink2">{i.descricao}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
