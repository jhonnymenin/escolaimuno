---
import Foto from '../ui/Foto.astro';
import Icon from '../ui/Icon.astro';
import { escola } from '../../content/escola';
import anfiteatro from '../../assets/local/anfiteatro.jpg';
import recepcao from '../../assets/local/recepcao.jpg';
import terraco from '../../assets/local/terraco.jpg';

const s = escola.lugar;
const local = escola.local;

const fotos = { anfiteatro, recepcao, terraco };

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(local.mapsQuery)}`;
const mapaEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(local.mapsQuery)}&z=16&output=embed`;
---
<section id="lugar" class="bg-mist py-16 sm:py-24 lg:py-32">
  <div class="shell">
    <p class="eyebrow text-ciano-texto">{s.rotulo}</p>
    <div class="mt-5 grid grid-cols-1 gap-x-10 gap-y-5 lg:grid-cols-12 lg:gap-x-16">
      <h2 class="h2-fluid max-w-[16ch] lg:col-span-6">{s.titulo}</h2>
      <div class="measure space-y-4 text-ink2 lg:col-span-6 lg:self-end">
        {s.paragrafos.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-3 lg:mt-16 lg:gap-x-8">
      {
        s.espacos.map((e) => (
          <li>
            <Foto
              src={fotos[e.foto as keyof typeof fotos]}
              alt={e.alt}
              ratio="4/3"
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 32vw, 100vw"
              widths={[420, 640, 900]}
            />
            <h3 class="mt-4 font-display text-lg font-bold tracking-[-0.01em]">{e.titulo}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink2">{e.descricao}</p>
          </li>
        ))
      }
    </ul>

    <div
      class="mt-14 grid grid-cols-1 gap-x-10 gap-y-10 border-t border-line pt-10 lg:mt-20 lg:grid-cols-12 lg:gap-x-16 lg:pt-12"
    >
      <div class="lg:col-span-5">
        <h3 class="h3-fluid">{s.comoChegarTitulo}</h3>
        <dl class="mt-6 space-y-5">
          {
            s.informacoes.map((i) => (
              <div>
                <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink2">
                  {i.titulo}
                </dt>
                <dd class="measure mt-1 text-[0.95rem] leading-relaxed">{i.texto}</dd>
              </div>
            ))
          }
        </dl>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex items-center gap-2.5 rounded-[4px] bg-navy px-6 py-3.5 text-[0.95rem] font-semibold text-white transition-colors duration-150 hover:bg-azul"
        >
          <Icon name="mapa" size={20} class="flex-none" />
          {s.comoChegarCta}
        </a>
      </div>

      <!-- O iframe do Google entra só quando a seção se aproxima da tela. -->
      <div class="lg:col-span-7">
        <div
          class="relative aspect-[4/3] w-full overflow-hidden bg-navy sm:aspect-[16/10]"
          data-mapa
          data-src={mapaEmbed}
          data-titulo={`Mapa com a localização da ${local.nomeCurto}`}
        >
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
            <Icon name="mapa" size={30} class="text-agua" />
            <p class="font-display text-base font-bold tracking-[-0.01em] text-white">
              {local.nomeCurto}
            </p>
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold text-agua underline underline-offset-[5px] decoration-1 hover:decoration-2"
            >
              {s.mapaCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // O mapa é um iframe de terceiro: só é montado quando a seção chega perto da
  // tela, para não pesar no carregamento inicial. Sem JS, fica o bloco com o
  // link para o Google Maps.
  const caixas = document.querySelectorAll<HTMLElement>('[data-mapa]');

  const montar = (caixa: HTMLElement) => {
    const src = caixa.dataset.src;
    if (!src || caixa.dataset.montado) return;
    caixa.dataset.montado = 'sim';

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = caixa.dataset.titulo || 'Mapa';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    caixa.replaceChildren(iframe);
  };

  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          obs.unobserve(e.target);
          montar(e.target as HTMLElement);
        });
      },
      { rootMargin: '400px 0px' }
    );
    caixas.forEach((c) => obs.observe(c));
  } else {
    caixas.forEach(montar);
  }
</script>
