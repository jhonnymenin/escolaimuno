---
import Foto from '../ui/Foto.astro';
import LogoRealizador from '../ui/LogoRealizador.astro';
import { escola } from '../../content/escola';
import foto from '../../assets/fotos/centro-cirurgico-duotone-claro.jpg';
import retrato from '../../assets/pessoas/antonio-condino-neto.jpg';
const s = escola.quemConduz;
const c = s.coordenacao;
---
<section id="quem-conduz" class="bg-white py-16 sm:py-24 lg:py-32">
  <div class="shell">
    <h2 class="h2-fluid max-w-[18ch]">{s.titulo}</h2>

    <Foto
      src={foto}
      alt="Equipe cirúrgica em procedimento, com monitor e instrumental montado"
      ratio="16/9"
      position="center 42%"
      sizes="(min-width: 1280px) 1120px, 100vw"
      widths={[640, 1024, 1600]}
      class="mt-10 lg:mt-14"
    />

    <ul
      class="mt-12 border-t border-line [--logo-h:1.75rem] md:[--logo-h:2rem] lg:mt-16 lg:[--logo-h:2.25rem]"
    >
      {
        s.realizadores.map((r) => (
          <li class="border-b border-line">
            <div class="grid grid-cols-1 items-center gap-x-10 gap-y-5 py-8 lg:grid-cols-12 lg:gap-x-16 lg:py-11">
              <div class="lg:col-span-4">
                <LogoRealizador logo={r.logo} nome={r.nome} />
              </div>
              <p class="measure-wide text-ink2 lg:col-span-8">{r.descricao}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-12 lg:mt-16 lg:gap-x-16">
      <div class="sm:col-span-4 lg:col-span-3">
        <Foto
          src={retrato}
          alt={c.alt}
          ratio="2/3"
          position="center 22%"
          sizes="(min-width: 1024px) 18vw, (min-width: 640px) 28vw, 60vw"
          widths={[260, 400, 475]}
          class="max-w-[14rem] sm:max-w-none"
        />
      </div>

      <div class="sm:col-span-8 lg:col-span-9 lg:self-center">
        <p class="eyebrow text-ciano-texto">{c.rotulo}</p>
        <h3 class="font-display mt-4 text-2xl font-bold tracking-[-0.02em] sm:text-3xl">
          {c.nome}
        </h3>
        <p class="mt-1.5 text-sm text-ink2">{c.crm}</p>
        <div class="measure-wide mt-5 space-y-4 text-ink2">
          {c.paragrafos.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
