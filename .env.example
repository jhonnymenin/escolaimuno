# Link do produto da TEMPORADA na EAD da ON.
# O normal é preencher src/config/checkout.ts, que também guarda os oito links
# de encontro avulso. Esta variável existe só para sobrescrever o link da
# temporada sem precisar de deploy. Vazia nos dois lugares, o CTA vai ao WhatsApp.
PUBLIC_CTA_URL=

# WhatsApp com DDI, apenas dígitos. Ex.: 5511970687422
PUBLIC_WHATSAPP=5511970687422

# E-mail ou link para empresas interessadas em patrocínio.
PUBLIC_SPONSOR_CONTACT=comercial@oneducacao.com.br

# Google Tag Manager (opcional). Ex.: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Meta Pixel (opcional). Ex.: 123456789012345
PUBLIC_META_PIXEL_ID=

# URL final do site, usada em canonical, Open Graph e sitemap.
PUBLIC_SITE_URL=https://escolaimunomediadas.com.br
